{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "enum": ["submitted", "abstained", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": ["status", "summary"],
  "additionalProperties": false
}
